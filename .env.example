# OpenRouter — https://openrouter.ai/ (default host-funded free models)
# Optional override; a baked-in demo key is used when unset.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=https://slopmark.vercel.app
OPENROUTER_APP_TITLE=slopmark
# optional comma list; empty = host key locked to :free models only
OPENROUTER_ALLOWLIST=

# AI/ML API — https://docs.aimlapi.com/ (use aiml/<model-id> slugs or BYOK)
AIMLAPI_KEY=
AIMLAPI_BASE=https://api.aimlapi.com/v1

# Fireworks serverless — use fireworks/<model-id> or fireworks/glm-5p1 short slugs
FIREWORKS_API_KEY=

# optional BYOK — use model slug custom/your-model-name
CUSTOM_API_BASE=
CUSTOM_API_KEY=

# optional supabase (eval persistence) — auth UI removed; public site needs no login
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
